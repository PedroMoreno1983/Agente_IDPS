# ============================================
# Agente de IA Psicométrico - Variables de Entorno
# ============================================
# Copiar este archivo a .env y configurar los valores

# ============================================
# Configuración General
# ============================================
DEBUG=false
ENVIRONMENT=development
APP_NAME="Agente Psicométrico IA"
APP_VERSION=0.1.0

# ============================================
# Configuración del Servidor
# ============================================
HOST=0.0.0.0
PORT=8000
WORKERS=1

# ============================================
# Base de Datos PostgreSQL
# ============================================
# Formato: postgresql://usuario:password@host:puerto/database
DATABASE_URL=postgresql://user:password@localhost:5432/psicometrico

# Pool de conexiones
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_ECHO=false

# ============================================
# Base de Datos Vectorial
# ============================================
# Opciones: chromadb, pinecone
VECTOR_DB_PROVIDER=chromadb

# Configuración ChromaDB (si VECTOR_DB_PROVIDER=chromadb)
CHROMADB_PATH=./data/chromadb
CHROMADB_COLLECTION=items_psicometricos

# Configuración Pinecone (si VECTOR_DB_PROVIDER=pinecone)
PINECONE_API_KEY=tu_api_key_aqui
PINECONE_ENVIRONMENT=us-west1-gcp
PINECONE_INDEX_NAME=items-psicometricos

# ============================================
# Modelos de Lenguaje (LLM)
# ============================================
# Opciones: openai, vertexai
LLM_PROVIDER=openai

# Configuración OpenAI (si LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-tu_api_key_aqui
OPENAI_MODEL=gpt-4
OPENAI_TEMPERATURE=0.3
OPENAI_MAX_TOKENS=2000

# Configuración Vertex AI (si LLM_PROVIDER=vertexai)
VERTEXAI_PROJECT_ID=tu-proyecto-gcp
VERTEXAI_LOCATION=us-central1
VERTEXAI_MODEL=gemini-pro
GOOGLE_APPLICATION_CREDENTIALS=/ruta/a/credenciales.json

# ============================================
# Embeddings
# ============================================
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
EMBEDDING_BATCH_SIZE=100

# ============================================
# Búsqueda Vectorial
# ============================================
VECTOR_SEARCH_TOP_K=10
VECTOR_SEARCH_THRESHOLD=0.7

# ============================================
# Seguridad
# ============================================
SECRET_KEY=tu-clave-secreta-muy-segura-cambiar-en-produccion
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM=HS256

# ============================================
# Logging
# ============================================
LOG_LEVEL=INFO
LOG_FORMAT="%(asctime)s - %(name)s - %(levelname)s - %(message)s"

# ============================================
# CORS
# ============================================
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Content-Type,Authorization

# ============================================
# Psicometría - Parámetros por defecto
# ============================================
PSIC_DIFICULTAD_MIN=-3.0
PSIC_DIFICULTAD_MAX=3.0
PSIC_DISCRIMINACION_MIN=0.5
PSIC_AJUSTE_P_VALOR_MIN=0.05
